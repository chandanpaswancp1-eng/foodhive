PORT=3000
GRUBCENTER_EMAIL=you@example.com
GRUBCENTER_PASSWORD=your-grubcenter-password

# Optional – only if auto-detection fails
# GRUBCENTER_PARTNER_ID=
# GRUBCENTER_TIMEZONE=Asia/Dubai
# GRUBCENTER_TOKEN_TYPE=id            # id | access
# GRUBCENTER_API_BASE=https://internal-api.grubtech.io/data-visualization/api/v1
# GRUBCENTER_ORDERS_PATH=/sales-data/order-details/
# GRUBCENTER_ITEMS_PATH=              # report path for item-availability ("86 items")
# GRUBCENTER_ORDER_ITEMS_PATH=        # report path for order-line-item sales
# GRUBCENTER_COGNITO_CLIENT_ID=       # overrides the two built-in fallback client IDs
# GRUBCENTER_COGNITO_REGION=eu-west-2
# GRUBCENTER_PAGE_SIZE=200

# Required in production (Vercel): secures /api/sync-cron so it can't be
# triggered by anyone who finds the URL. Vercel sends this automatically as
# a Bearer header for its own Cron Jobs; set the same value here and in the
# Vercel project's env vars.
# CRON_SECRET=

# Zoho Books (OAuth2 self-client, read-only scopes). Create a Self Client at
# https://api-console.zoho.com with scopes:
#   ZohoBooks.settings.READ,ZohoBooks.reports.READ,ZohoBooks.invoices.READ,ZohoBooks.bills.READ,ZohoBooks.banking.READ
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
# Optional – defaults to the global (.com) data center
# ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com
# ZOHO_API_DOMAIN=https://www.zohoapis.com
