{
  "framework": null,
  "rewrites": [
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/((?!api/).*)", "destination": "/public/$1" }
  ],
  "crons": [
    { "path": "/api/sync-cron", "schedule": "0 23 * * *" }
  ],
  "functions": {
    "api/sync-cron.js": { "maxDuration": 60 },
    "api/orders.js": { "maxDuration": 60 },
    "api/order-items.js": { "maxDuration": 60 },
    "api/refresh.js": { "maxDuration": 60 },
    "api/accounting.js": { "maxDuration": 60 },
    "api/accounting/refresh.js": { "maxDuration": 60 }
  }
}
